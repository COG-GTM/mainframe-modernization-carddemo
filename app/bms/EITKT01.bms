         PRINT NOGEN
EITKT01  DFHMSD TYPE=&SYSPARM,LANG=COBOL,MODE=INOUT,                  X
               STORAGE=AUTO,CTRL=FREEKB,TIOAPFX=YES,TERM=3270-2
EITKT1A  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(01,01),LENGTH=40,                                 X
               ATTRB=(ASKIP,BRT),                                      X
               INITIAL='ECI RETAIL - Detalle Ticket'
         DFHMDF POS=(04,05),LENGTH=15,ATTRB=(ASKIP),                   X
               INITIAL='ID Ticket:    '
TKTID    DFHMDF POS=(04,21),LENGTH=16,ATTRB=(UNPROT,IC)
         DFHMDF POS=(06,05),LENGTH=15,ATTRB=(ASKIP),                   X
               INITIAL='Centro:       '
TKTCNT   DFHMDF POS=(06,21),LENGTH=05,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(07,05),LENGTH=15,ATTRB=(ASKIP),                   X
               INITIAL='Seccion:      '
TKTSEC   DFHMDF POS=(07,21),LENGTH=30,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(08,05),LENGTH=15,ATTRB=(ASKIP),                   X
               INITIAL='Importe:      '
TKTIMP   DFHMDF POS=(08,21),LENGTH=12,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(09,05),LENGTH=15,ATTRB=(ASKIP),                   X
               INITIAL='Articulos:    '
TKTART   DFHMDF POS=(09,21),LENGTH=03,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(10,05),LENGTH=15,ATTRB=(ASKIP),                   X
               INITIAL='Metodo Pago:  '
TKTPAG   DFHMDF POS=(10,21),LENGTH=02,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(11,05),LENGTH=15,ATTRB=(ASKIP),                   X
               INITIAL='Fecha/Hora:   '
TKTFEC   DFHMDF POS=(11,21),LENGTH=26,ATTRB=(ASKIP,BRT)
ERRMSG   DFHMDF POS=(20,02),LENGTH=78,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(23,01),LENGTH=40,ATTRB=(ASKIP),                   X
               INITIAL='PF3=Menu  ENTER=Buscar'
         DFHMSD TYPE=FINAL
         END
