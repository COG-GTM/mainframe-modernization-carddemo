# Per-program build/run manifest for CBSTM03A (job CREASTMT, statement creation).
# CBSTM03A CALLs subprogram CBSTM03B, so it is compiled/linked in via SUBPROGRAMS.
# Its shared copybooks (e.g. CUSTREC.cpy) are tab-indented; -ftab-width=1 keeps
# them aligned in fixed format (default flag; shown here for clarity). No source
# change.
RUN_MODE=executable
SUBPROGRAMS=CBSTM03B
COBC_FLAGS=-ftab-width=1
PROGRAM_PARM=
