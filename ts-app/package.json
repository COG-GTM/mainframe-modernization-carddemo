{
  "name": "carddemo-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript reimplementation of the CardDemo COBOL/CICS application",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "tsx src/online/server.ts",
    "batch:post": "tsx src/batch/postTransactions.ts"
  },
  "dependencies": {
    "decimal.js": "10.4.3",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
