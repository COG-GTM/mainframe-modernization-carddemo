# Per-program build/run manifest for CBTRN02C (job POSTTRAN).
# Sourced by containers/Dockerfile.batch (build) and containers/entrypoint.sh (run),
# so callers only pass --build-arg PROGRAM=CBTRN02C. All keys are optional; the
# values below are the defaults, shown for documentation.
RUN_MODE=executable      # executable (cobc -x) | module (cobc -m + cobcrun)
SUBPROGRAMS=             # space-separated called subprograms to compile/link
COBC_FLAGS=-ftab-width=1 # keeps tab-indented copybooks aligned in fixed format
PROGRAM_PARM=            # JCL PARM= value (none for CBTRN02C)
