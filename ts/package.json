{
  "name": "carddemo-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript migration of the CardDemo COBOL/CICS/VSAM application under app/",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
