# DD / ASSIGN name  ->  dataset file (relative to $DATA_DIR, e.g. /data)
# Program: CBTRN02C (job POSTTRAN) - daily transaction posting.
# Names mirror the JCL DD-to-DSN bindings in app/jcl/POSTTRAN.jcl and keep the
# AWS.M2.CARDDEMO.* naming. See docs/modernization/CURRENT_STATE_ANALYSIS.md 4.1.
#
# DD (ASSIGN)   dataset (organization)
DALYTRAN=AWS.M2.CARDDEMO.DALYTRAN.PS          # sequential input
TRANFILE=AWS.M2.CARDDEMO.TRANSACT.VSAM.KSDS   # indexed, key FD-TRANS-ID
XREFFILE=AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS   # indexed, key FD-XREF-CARD-NUM
ACCTFILE=AWS.M2.CARDDEMO.ACCTDATA.VSAM.KSDS   # indexed, key FD-ACCT-ID
TCATBALF=AWS.M2.CARDDEMO.TCATBALF.VSAM.KSDS   # indexed, key FD-TRAN-CAT-KEY
DALYREJS=AWS.M2.CARDDEMO.DALYREJS             # sequential output (GDG +1)
