    "test:watch": "vitest",
    "lint": "eslint .",
    "generate:models": "tsx scripts/generate-models.ts",
    "seed": "tsx src/loaders/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
