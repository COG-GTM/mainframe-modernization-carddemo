# DD/ASSIGN -> AWS.M2.CARDDEMO.* mapping for CBSTM03A (job CREASTMT).
# Mirrors app/jcl/CREASTMT.JCL step STEP040. CBSTM03A writes STMTFILE/HTMLFILE;
# its called subprogram CBSTM03B reads TRNXFILE/XREFFILE/ACCTFILE/CUSTFILE, so all
# DDs are mapped here. Names unchanged.
STMTFILE=AWS.M2.CARDDEMO.STATEMNT.PS
HTMLFILE=AWS.M2.CARDDEMO.STATEMNT.HTML
TRNXFILE=AWS.M2.CARDDEMO.TRXFL.VSAM.KSDS
XREFFILE=AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS
ACCTFILE=AWS.M2.CARDDEMO.ACCTDATA.VSAM.KSDS
CUSTFILE=AWS.M2.CARDDEMO.CUSTDATA.VSAM.KSDS
