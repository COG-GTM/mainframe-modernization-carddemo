      *****************************************************************
      * Generated by tests/batch/harness: loads (IDXUTIL_MODE=LOAD) a
      * line-sequential file into an indexed (VSAM KSDS stand-in) file
      * or dumps (IDXUTIL_MODE=DUMP) an indexed file back to text.
      *****************************************************************
       IDENTIFICATION DIVISION.
       PROGRAM-ID. @PROGRAM@.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TXT-FILE ASSIGN TO IDXTXT
                  ORGANIZATION IS LINE SEQUENTIAL
                  FILE STATUS IS WS-TXT-STAT.
           SELECT IDX-FILE ASSIGN TO IDXFILE
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS IDX-KEY
@ALTKEY@
                  FILE STATUS IS WS-IDX-STAT.
       DATA DIVISION.
       FILE SECTION.
       FD TXT-FILE.
       01 TXT-REC              PIC X(@RECLEN@).
       FD IDX-FILE.
       01 IDX-REC.
@FIELDS@
       WORKING-STORAGE SECTION.
       01 WS-MODE              PIC X(4) VALUE SPACES.
       01 WS-TXT-STAT          PIC XX.
       01 WS-IDX-STAT          PIC XX.
       01 WS-EOF               PIC X VALUE 'N'.
       PROCEDURE DIVISION.
           ACCEPT WS-MODE FROM ENVIRONMENT 'IDXUTIL_MODE'
           IF WS-MODE = 'DUMP'
              OPEN INPUT IDX-FILE OUTPUT TXT-FILE
           ELSE
              OPEN INPUT TXT-FILE OUTPUT IDX-FILE
           END-IF
           IF WS-TXT-STAT NOT = '00' OR WS-IDX-STAT NOT = '00'
              DISPLAY 'IDXUTIL OPEN FAILED ' WS-TXT-STAT ' '
                      WS-IDX-STAT
              MOVE 8 TO RETURN-CODE
              STOP RUN
           END-IF
           PERFORM UNTIL WS-EOF = 'Y'
              IF WS-MODE = 'DUMP'
                 READ IDX-FILE NEXT
                   AT END MOVE 'Y' TO WS-EOF
                   NOT AT END WRITE TXT-REC FROM IDX-REC
                 END-READ
              ELSE
                 READ TXT-FILE
                   AT END MOVE 'Y' TO WS-EOF
                   NOT AT END
                     WRITE IDX-REC FROM TXT-REC
                     IF WS-IDX-STAT NOT = '00'
                        DISPLAY 'IDXUTIL WRITE FAILED ' WS-IDX-STAT
                        MOVE 8 TO RETURN-CODE
                     END-IF
                 END-READ
              END-IF
           END-PERFORM
           CLOSE TXT-FILE IDX-FILE
           STOP RUN.
