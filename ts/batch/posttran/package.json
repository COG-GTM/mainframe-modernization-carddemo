{
  "name": "@carddemo/posttran",
  "version": "1.0.0",
  "description": "TypeScript port of the CardDemo CBTRN02C daily transaction posting batch (POSTTRAN JCL job)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "posttran": "tsx src/posttran.ts",
    "posttran:dist": "node dist/posttran.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "bin": {
    "posttran": "dist/posttran.js"
  }
}
