{
  "name": "carddemo-ts-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3270-style React UI for the CardDemo TypeScript online slice",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
